---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import { sanityClient, urlFor } from '../lib/sanity';
import Navbar from '@/components/layout/Navbar';
import Footer from '@/components/section/Footer.astro';
import FloatingWhatsApp from '@/components/ui/FloatingWhatsApp.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: any;
  brandName?: string;
  lang?: 'id' | 'en'; 
  noIndex?: boolean;
  alternativeLangPath?: string;
}

const { title, description, image, brandName: propBrandName, noIndex, lang = 'id', alternativeLangPath } = Astro.props;
const currentPath = Astro.url.pathname;

// Ambil data CMS
const query = `*[_type == "siteSettings"][0]`;
const siteSettings = (await sanityClient.fetch(query)) || {};

// Fetch pricing categories for Navbar dropdown — deduplicated with slugs
const toSlug = (s: string) =>
  s.toLowerCase().trim().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');

let serviceCategories: { name: string; slug: string }[] = [];
try {
  const pricingData: string[] = await sanityClient.fetch(
    `*[_type == "pricingSection"][0].pricingPackages[].category.id`
  );
  if (Array.isArray(pricingData)) {
    const unique = [...new Set(pricingData.filter(Boolean))];
    serviceCategories = unique.map((name) => ({ name, slug: toSlug(name) }));
  }
} catch (_) {}

// --- RESOLUSI TEKS SEO ---
const finalBrandName = propBrandName || siteSettings.brandName || 'Agency Profile';
const baseSeoTitle = siteSettings.title || finalBrandName;

const fallbackSuffix = siteSettings.seoTitleSuffix?.[lang] || '';
const seoSuffix = fallbackSuffix ? ` ${fallbackSuffix}` : '';
const finalTitle = title ? `${title} - ${baseSeoTitle}` : `${baseSeoTitle}${seoSuffix}`;

const defaultDesc = siteSettings.description?.[lang] || 'Professional Agency services.';
const finalDesc = description || defaultDesc;
const finalKeywords = siteSettings.keywords?.[lang] || '';

// --- RESOLUSI URL & GAMBAR ---
const siteUrl = siteSettings.siteUrl || Astro.site || Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();

const imageSource = image || siteSettings.ogImage;
const finalOgImage = imageSource ? urlFor(imageSource).width(1200).height(630).format('webp').url() : '';

// --- LOGIKA ROBOTS & INDEXING ---
const globalIsIndexable = siteSettings?.allowIndexing !== false;
const robotsContent = (noIndex || !globalIsIndexable) ? 'noindex, nofollow' : 'index, follow';

// --- HREFLANG URLs ---
const idUrl = new URL('/', siteUrl).toString();
const enUrl = new URL('/en/', siteUrl).toString();

// GTM ID (Ganti gaId menjadi gtmId di Sanity nanti, atau hardcode di sini sementara)
// Contoh fallback: const gtmId = siteSettings.gtmId || 'GTM-XXXXXXX';
const gtmId = siteSettings.gtmId; 
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    {/* --- PRECONNECT UNTUK PERFORMA (Best Practice PageSpeed) --- */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    {gtmId && <link rel="preconnect" href="https://www.googletagmanager.com" />}

    {/* --- GOOGLE FONTS (Non-blocking) --- */}
    <link href="https://fonts.googleapis.com/css2?family=Suranna&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Suranna&display=swap" rel="stylesheet" />
    </noscript>

    <title>{finalTitle}</title>
    <meta name="title" content={finalTitle} />
    <meta name="description" content={finalDesc} />
    {finalKeywords && <meta name="keywords" content={finalKeywords} />}
    
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robotsContent} />

    {/* --- MULTILINGUAL SEO --- */}
    <link rel="alternate" hreflang="id" href={idUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    
    {siteSettings.googleSiteVerification && (
      <meta name="google-site-verification" content={siteSettings.googleSiteVerification} />
    )}

    {/* --- OPEN GRAPH (FACEBOOK/LINKEDIN) --- */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDesc} />
    <meta property="og:site_name" content={baseSeoTitle} />
    {finalOgImage && <meta property="og:image" content={finalOgImage} />}

    {/* --- TWITTER CARDS --- */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={finalTitle} />
    <meta property="twitter:description" content={finalDesc} />
    {finalOgImage && <meta property="twitter:image" content={finalOgImage} />}
    {siteSettings.twitterHandle && <meta property="twitter:site" content={siteSettings.twitterHandle} />}

    {/* --- SCHEMA MARKUP (JSON-LD) --- */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": baseSeoTitle,
      "url": siteUrl,
      "description": finalDesc,
      "publisher": {
        "@id": `${siteUrl}/#organization`
      }
    })} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@id": `${siteUrl}/#organization`,
      "@type": "Organization",
      "name": finalBrandName,
      "url": siteUrl,
      "logo": finalOgImage || "",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": siteSettings.contactNumber || "+6281234567890",
        "contactType": "sales",
        "areaServed": "ID",
        "availableLanguage": ["id", "en"]
      },
      "sameAs": siteSettings.socialLinks?.map((s: any) => s.url) || []
    })} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": finalBrandName,
      "image": finalOgImage || "",
      "@id": siteUrl,
      "url": siteUrl,
      "telephone": siteSettings.contactNumber || "+6281234567890",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tangerang",
        "addressRegion": "Banten",
        "addressCountry": "ID"
      },
      "areaServed": [
        { "@type": "City", "name": "Tangerang" },
        { "@type": "City", "name": "Serang" },
        { "@type": "State", "name": "Banten" },
        { "@type": "Country", "name": "Indonesia" }
      ],
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -6.1783,
        "longitude": 106.6319
      }
    })} />

    {/* --- GOOGLE TAG MANAGER (Head) --- */}
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      </script>
    )}
  </head>
  <body class="min-h-screen bg-slate-50 font-sans text-slate-900 antialiased">
    
    {/* --- GOOGLE TAG MANAGER (Body/NoScript) --- */}
    {gtmId && (
      <noscript>
        <iframe 
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} 
          height="0" 
          width="0" 
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}

    <Navbar 
      client:load 
      brandName={finalBrandName} 
      currentLang={lang} 
      currentPath={currentPath}
      serviceCategories={serviceCategories}
      alternativeLangPath={alternativeLangPath}
    />
    
    <main class="w-full flex-col">
      <slot />
    </main>
    
    <Footer lang={lang} currentPath={currentPath} serviceCategories={serviceCategories} />
    <FloatingWhatsApp lang={lang} />

    {/* --- UTM TRACKING SCRIPT --- */}
    <script is:inline>
      (function() {
        // Optimization: Defer tracking script to improve PageSpeed
        function initTracking() {
          const UTM_PARAMS = ['utm_source', 'utm_medium', 'utm_campaign'];
          const SEARCH_ENGINES = ['google', 'bing', 'yahoo', 'duckduckgo', 'baidu', 'yandex'];
          
          // 1. Capture UTM / Organic from URL and save to sessionStorage
          try {
            const urlParams = new URLSearchParams(window.location.search);
            let hasUtm = false;
            UTM_PARAMS.forEach(param => {
              const value = urlParams.get(param);
              if (value) {
                sessionStorage.setItem('wa_' + param, value);
                hasUtm = true;
              }
            });

            if (!hasUtm && document.referrer) {
              const referrer = document.referrer.toLowerCase();
              const isOrganic = SEARCH_ENGINES.some(engine => referrer.includes(engine));
              if (isOrganic) {
                let engineSource = 'google';
                for (const engine of SEARCH_ENGINES) {
                  if (referrer.includes(engine)) {
                    engineSource = engine;
                    break;
                  }
                }
                sessionStorage.setItem('wa_utm_source', engineSource);
                sessionStorage.setItem('wa_utm_medium', 'organic');
              }
            }
          } catch (e) {}

          // 2. Helper to update WhatsApp links
          function updateWaLink(link) {
            try {
              const href = link.getAttribute('href');
              if (!href || !href.includes('wa.me')) return;
              if (link.getAttribute('data-wa-utm-applied') === window.location.href) return;

              const utmSource = sessionStorage.getItem('wa_utm_source');
              const utmMedium = sessionStorage.getItem('wa_utm_medium');
              const utmCampaign = sessionStorage.getItem('wa_utm_campaign');

              const url = new URL(href, window.location.origin);
              const currentText = (url.searchParams.get('text') || '').split('\n\n--')[0];
              
              let newText = currentText;
              newText += `\n\n--\nPage: ${window.location.href}`;

              if (utmSource || utmMedium || utmCampaign) {
                newText += '\n\n--';
                if (utmSource) newText += `\nSource: ${utmSource}`;
                if (utmMedium) newText += `\nMedium: ${utmMedium}`;
                if (utmCampaign) newText += `\nCampaign: ${utmCampaign}`;
              }

              url.searchParams.set('text', newText);
              link.href = url.toString();
              link.setAttribute('data-wa-utm-applied', window.location.href);
            } catch (e) {}
          }

          function processAllLinks() {
            const links = document.querySelectorAll('a[href*="wa.me"]');
            links.forEach(updateWaLink);
          }

          const observer = new MutationObserver((mutations) => {
            let shouldProcess = false;
            for (const mutation of mutations) {
              if (mutation.addedNodes.length > 0) {
                shouldProcess = true;
                break;
              }
            }
            if (shouldProcess) processAllLinks();
          });

          if (document.body) {
            observer.observe(document.body, { childList: true, subtree: true });
            processAllLinks();
          }
        }

        // Defer execution until idle or small timeout to avoid blocking initial render
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(() => initTracking());
        } else {
          setTimeout(() => initTracking(), 200);
        }
      })();
    </script>
  </body>
</html>