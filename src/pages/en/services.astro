---
// src/pages/en/services.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServicesHero from '@/components/section/ServicesHero.astro';
import About from '@/components/section/About.astro';
import ServicesWhatWeDo from '@/components/section/ServicesWhatWeDo.astro';
import Pricing from '@/components/section/Pricing.astro';
import FAQ from '@/components/section/FAQ.astro';
import Contact from '@/components/section/Contact.astro';
import { sanityClient } from '@/lib/sanity';

const lang = 'en';

// Parallel Sanity fetch — same pattern as en/index.astro
let aboutData = null;
let whatWeDoData = null;

try {
  [aboutData, whatWeDoData] = await Promise.all([
    sanityClient.fetch(`*[_type == "about"][0]`),
    sanityClient.fetch(`*[_type == "whatWeDo"][0]`),
  ]);
} catch (error) {
  console.error('Sanity Fetch Error (en/services.astro):', error);
}
---

<BaseLayout
  lang={lang}
  title='Our Services'
  description='We provide world-class digital solutions — landing pages, company profiles, and e-commerce stores built with modern technology and proven SEO strategies.'>

  {/* JSON-LD BreadcrumbList */}
  <script
    type='application/ld+json'
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://arvellocreative.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://arvellocreative.com/en/services' },
      ],
    })}
  />


  <ServicesHero lang={lang} />

  <About
    lang={lang}
    headline={aboutData?.headline}
    description={aboutData?.description}
    statistics={aboutData?.statistics}
  />

  <ServicesWhatWeDo
    lang={lang}
    headline={whatWeDoData?.headline}
    description={whatWeDoData?.description}
    gridItems={whatWeDoData?.gridItems}
  />

  <Pricing lang={lang} />

  <FAQ lang={lang} />

  <Contact lang={lang} />
</BaseLayout>
