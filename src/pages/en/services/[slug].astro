---
// src/pages/en/services/[slug].astro
// Dedicated service category page — e.g. /en/services/landing-page
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServicesHero from '@/components/section/ServicesHero.astro';
import Pricing from '@/components/section/Pricing.astro';
import FAQ from '@/components/section/FAQ.astro';
import Contact from '@/components/section/Contact.astro';
import { sanityClient } from '@/lib/sanity';
import About from '@/components/section/About.astro';
import ServicesWhatWeDo from '@/components/section/ServicesWhatWeDo.astro';
import HowItWorks from '@/components/section/HowItWorks.astro';
import SiloContent from '@/components/section/SiloContent.astro';
import BlogOverview from '@/components/section/BlogOverview.astro';

const lang = 'en';
let aboutData = null;
let whatWeDoData = null;
let howItWorksData = null;
try {
  [aboutData, whatWeDoData, howItWorksData] = await Promise.all([
    sanityClient.fetch(`*[_type == "about"][0]`),
    sanityClient.fetch(`*[_type == "whatWeDo"][0]`),
    sanityClient.fetch(`*[_type == "howItWorks"][0]`),
  ]);
} catch (error) {
  console.error('Sanity Fetch Error (layanan.astro):', error);
}

// ─── Static path generation ───────────────────────────────────────────────────
export async function getStaticPaths() {
  const toSlug = (s: string) =>
    s
      .toLowerCase()
      .trim()
      .replace(/\s+/g, '-')
      .replace(/[^a-z0-9-]/g, '');

  const categories: string[] = await sanityClient.fetch(
    `*[_type == "pricingSection"][0].pricingPackages[].category.id`,
  );
  const unique = [...new Set(categories.filter(Boolean))];
  return unique.map((name) => ({
    params: { slug: toSlug(name) },
    props: { categoryName: name },
  }));
}

const { slug } = Astro.params;
const { categoryName } = Astro.props;

const pageTitle = `${categoryName} — Our Services`;
const pageDesc = `${categoryName} packages from Arvello Creative — professional digital solutions with transparent pricing and full-featured deliverables.`;

// --- SILO SEO CONTENT DATA MAPPING (English) ---
const isWebsiteCategory = slug.includes('website');

const siloData = isWebsiteCategory
  ? {
      title: `Professional Web Design Services in Tangerang and Serang`,
      intro: `Resolusiweb provides professional website services in Tangerang and Serang designed to help businesses, SMEs, and companies have modern, fast, and effective websites that support digital business growth. As a professional web development service, we start every project by understanding business needs, website goals, and the target market in the Banten region so that the end result is not only visually appealing but also optimal in functionality and user experience.\n\nThrough our professional website services in Tangerang and Serang, you get planned and transparent web development solutions. We ensure responsive design across all devices, SEO-friendly page structures, and a professional look that builds trust with potential customers. This service is ideal for businesses looking to establish a strong digital identity and maximize online marketing potential in the Serang and Tangerang areas.`,
      secondaryTitle: `Our Other Services`,
      secondaryContent: `Resolusiweb also provides SEO services, SEO article writing, UI/UX optimization, and digital marketing tool integration designed for businesses in Tangerang, Serang, and surrounding areas. Every website is built with a strong SEO structure, professional design, and optimal performance so it's ready to be used as a medium for branding and online marketing.`,
      benefitsTitle: `Why Do You Need a Professional Website in Banten?`,
      benefits: [
        'Professional look that builds customer trust',
        'Easy for local customers in Tangerang & Serang to find you',
        'Enhanced brand credibility in the Banten regional market',
        'Ready for advanced digital marketing strategies',
        '24/7 active online promotion platform',
      ],
      faqTitle: `Web Design FAQ in Tangerang & Serang`,
      faqs: [
        {
          q: 'What is Tangerang & Serang professional web design service?',
          a: "It's a web development service specifically designed to help businesses in Banten have modern, responsive websites according to current digital standards.",
        },
        {
          q: 'Why does a business need a professional website?',
          a: 'A professional website helps build business credibility and makes it easier for customers to get information quickly.',
        },
        {
          q: 'How long is the web development process?',
          a: 'The process generally takes 2 to 6 weeks, depending on design complexity and feature requirements.',
        },
        {
          q: 'Is the website SEO-friendly?',
          a: 'Yes, every website built by Resolusiweb is optimized for search engines so your customers in Tangerang and Serang can find you easily.',
        },
      ],
      footerTitle: `Tangerang & Serang Web Development Solutions`,
      footerContent: `Don't have a website yet or want a high-quality one at an affordable price? Trust your company's web development in Tangerang and Serang to us. We combine premium aesthetics with strong technical functionality to ensure your success.`,
    }
  : {
      // Generic Fallback
      title: `Professional ${categoryName} Services in Tangerang & Serang`,
      intro: `Resolusiweb provides ${categoryName} services designed specifically to increase your business performance in Tangerang, Serang, and across the Banten region. With a strategic approach and professional execution, we ensure every project delivers real impact for local businesses and B2B companies looking to scale up.`,
      benefitsTitle: `Why Choose Us for ${categoryName}?`,
      benefits: [
        `Certified expert team focused on the Banten digital market`,
        `Data-driven approach for maximum conversion results`,
        `Transparent process and regular communication in Tangerang & Serang`,
        `Customized solutions for your specific regional growth needs`,
      ],
      faqTitle: `Questions about ${categoryName} in Tangerang & Serang`,
      faqs: [
        {
          q: `What are the advantages of ${categoryName} at Arvello compared to other Banten agencies?`,
          a: `We combine premium design aesthetics with strong technical functionality that specifically targets the Tangerang and Serang markets.`,
        },
        {
          q: `Is this service suitable for SMEs in Serang?`,
          a: `Absolutely. Our services are flexible, catering to both local SMEs in Serang and larger corporations in Tangerang seeking complex digital ecosystems.`,
        },
      ],
      footerTitle: `Grow Your Business with ${categoryName}`,
      footerContent: `Ready to take the next step in Tangerang or Serang? Contact us now to discuss how our ${categoryName} services can help you achieve your business targets in Banten.`,
    };
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={pageDesc}>
  {/* JSON-LD BreadcrumbList */}
  <script
    type='application/ld+json'
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      '@id': `${Astro.url.href}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://www.arvellocreative.com/en/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Services',
          item: 'https://www.arvellocreative.com/en/services',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: categoryName,
          item: Astro.url.href,
        },
      ],
    })}
  />

  {/* Service Schema */}
  <script
    type='application/ld+json'
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: `Professional ${categoryName} Services in Tangerang & Serang`,
      description: pageDesc,
      provider: {
        '@id': 'https://www.arvellocreative.com/#organization',
      },
      areaServed: [
        { '@type': 'City', name: 'Tangerang' },
        { '@type': 'City', name: 'Serang' },
        { '@type': 'State', name: 'Banten' },
      ],
      mainEntityOfPage: {
        '@id': Astro.url.href,
      },
    })}
  />

  {/* FAQPage Schema (Dynamic from siloData) */}
  {
    siloData.faqs && siloData.faqs.length > 0 && (
      <script
        type='application/ld+json'
        is:inline
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: siloData.faqs.map((faq) => ({
            '@type': 'Question',
            name: faq.q,
            acceptedAnswer: {
              '@type': 'Answer',
              text: faq.a,
            },
          })),
        })}
      />
    )
  }

  <ServicesHero
    lang={lang}
    headlinePre='Service'
    headlineAccent={categoryName}
    headlineSuf='Professional'
    description={`Premium digital solutions for your ${categoryName} business needs. We help develop your digital potential with the right strategy.`}
  />
  <About
    lang={lang}
    headline={aboutData?.headline}
    description={aboutData?.description}
    statistics={aboutData?.statistics}
  />

  <ServicesWhatWeDo
    lang={lang}
    headline={whatWeDoData?.headline}
    description={whatWeDoData?.description}
    gridItems={whatWeDoData?.gridItems}
  />
  <Pricing
    lang={lang}
    highlightCategory={categoryName}
  />
  <HowItWorks
    lang={lang}
    headline={howItWorksData?.headline}
    description={howItWorksData?.description}
    mainImage={howItWorksData?.mainImage}
    steps={howItWorksData?.steps}
  />
  <SiloContent
    lang={lang}
    data={siloData}
  />
  <BlogOverview
    lang={lang}
    categorySlug={slug}
  />
  <FAQ lang={lang} />

  <Contact lang={lang} />
</BaseLayout>
