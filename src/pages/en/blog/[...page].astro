---
// src/pages/en/blog/[...page].astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanityClient, urlFor } from '@/lib/sanity';
import type { GetStaticPathsOptions } from 'astro';
import { ChevronRight, ChevronLeft } from 'lucide-react';

// SSG PAGINATION
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const query = `
    *[_type == "post"] | order(publishedAt desc) {
      _id,
      title,
      slug,
      mainImage,
      publishedAt,
      excerpt,
      categories[]->{title},
      author->{name, image}
    }
  `;
  const posts = await sanityClient.fetch(query);

  // Featured post is always the first one, the rest are paginated in 9s (3x3 grid)
  const [firstPost, ...restPosts] = posts;

  return paginate(restPosts, { 
    pageSize: 9,
    props: { featuredPost: firstPost }
  });
}

// Typings for the paginated prop from Astro
const { page, featuredPost: initialFeaturedPost } = Astro.props;
const lang = 'en';

// Stable Featured Post Logic (Hanya muncul di Page 1)
const featuredPost = page.currentPage === 1 ? initialFeaturedPost : null;
const gridPosts = page.data;

// Static Text
const pageTitle = 'The Hub for Digital Insights\n& Business Growth';
const pageDesc =
  'Discover advanced conversion tactics, SEO fundamentals, and the power of modern web technology. We share proven, actionable strategies to help you dominate your market and multiply your revenue.';
---

<BaseLayout
  lang={lang}
  title={`Blog & Insights ${page.currentPage > 1 ? `- Page ${page.currentPage}` : ''}`}
  description={pageDesc}>
  <div
    class='relative pt-32 pb-20 md:pt-48 md:pb-32 bg-slate-50 min-h-screen overflow-hidden'>
    <div class='container mx-auto px-4 max-w-7xl relative z-10'>
      {/* --- HEADER SECTION --- */}
      <div
        class='flex flex-col lg:flex-row gap-8 lg:gap-16 items-start lg:items-center mb-16 md:mb-24 border-b border-slate-200 pb-12 animate-in fade-in slide-in-from-bottom-8 duration-700'>
        <h1
          class='text-5xl md:text-6xl lg:text-7xl font-extrabold text-slate-900 tracking-tight leading-tight lg:w-1/2 whitespace-pre-line'>
          {pageTitle}
        </h1>
        <p class='text-lg text-slate-500 leading-relaxed lg:w-1/2'>
          {pageDesc}
        </p>
      </div>

      {/* --- FEATURED POST (Hanya di Halaman 1) --- */}
      {
        featuredPost && (
          <div class='mb-20 animate-in fade-in slide-in-from-bottom-12 duration-700 delay-100'>
            <div class='grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center'>
              <a
                href={`/en/blog/${featuredPost.slug.en.current}`}
                class='group relative aspect-4/3 lg:aspect-square overflow-hidden rounded-[2rem] shadow-lg border border-slate-100 block'>
                <img
                  src={
                    featuredPost.mainImage
                      ? urlFor(featuredPost.mainImage)
                          .width(800)
                          .format('webp')
                          .url()
                      : ''
                  }
                  srcset={
                    featuredPost.mainImage
                      ? `
                    ${urlFor(featuredPost.mainImage).width(400).format('webp').url()} 400w,
                    ${urlFor(featuredPost.mainImage).width(800).format('webp').url()} 800w,
                    ${urlFor(featuredPost.mainImage).width(1200).format('webp').url()} 1200w
                  `
                      : ''
                  }
                  sizes='(max-width: 1024px) 100vw, 50vw'
                  alt={featuredPost.title?.[lang] || 'Featured'}
                  class='w-full h-full object-cover group-hover:scale-105 transition-transform duration-700'
                  loading='eager'
                  decoding='async'
                />
                <div class='absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-500' />
              </a>

              <div class='flex flex-col justify-center'>
                <a
                  href={`/en/blog/${featuredPost.slug.en.current}`}
                  class='group'>
                  <h2 class='text-3xl md:text-4xl lg:text-5xl font-extrabold text-slate-900 group-hover:text-blue-600 transition-colors mb-6 leading-tight capitalize'>
                    {featuredPost.title?.[lang]}
                  </h2>
                </a>
                <p class='text-lg text-slate-500 mb-10 leading-relaxed line-clamp-3'>
                  {featuredPost.excerpt?.[lang]}
                </p>

                <div class='grid grid-cols-2 md:grid-cols-3 gap-6 mb-10 pb-10 border-b border-slate-200'>
                  <div>
                    <p class='text-sm text-slate-400 mb-1.5'>Category</p>
                    <div class="flex flex-wrap gap-2">
                      {featuredPost.categories?.map((cat: any) => (
                        <span class="px-3 py-1 bg-slate-100 text-slate-900 rounded-lg text-[10px] font-bold uppercase tracking-wider border border-slate-200">
                          {cat.title?.[lang]}
                        </span>
                      )) || <span class="text-slate-900 font-semibold">General</span>}
                    </div>
                  </div>
                  <div>
                    <p class='text-sm text-slate-400 mb-1'>Publication Date</p>
                    <p class='font-semibold text-slate-900'>
                      {new Date(featuredPost.publishedAt).toLocaleDateString(
                        'en-US',
                        { day: 'numeric', month: 'long', year: 'numeric' },
                      )}
                    </p>
                  </div>
                  <div class='hidden md:block'>
                    <p class='text-sm text-slate-400 mb-1'>Author</p>
                    <p class='font-semibold text-slate-900'>
                      {featuredPost.author?.name || 'Editorial Team'}
                    </p>
                  </div>
                </div>

                <div>
                  <a
                    href={`/en/blog/${featuredPost.slug.en.current}`}
                    class='inline-flex items-center justify-center px-8 py-4 text-sm font-bold border border-slate-300 rounded-full text-slate-700 hover:bg-slate-900 hover:text-white hover:border-slate-900 transition-all duration-300'>
                    Read More
                  </a>
                </div>
              </div>
            </div>
          </div>
        )
      }

      {/* --- GRID POSTS --- */}
      {
        gridPosts.length > 0 && (
          <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10'>
            {gridPosts.map((post: any, index: number) => {
              const title = post.title?.[lang] || 'Untitled Post';
              const categories = post.categories?.map((cat: any) => cat.title?.[lang]) || ['General'];
              const imageUrl = post.mainImage
                ? urlFor(post.mainImage).width(600).format('webp').url()
                : '';

              const imageSrcset = post.mainImage
                ? `
                    ${urlFor(post.mainImage).width(400).format('webp').url()} 400w,
                    ${urlFor(post.mainImage).width(800).format('webp').url()} 800w
                  `
                : '';

              if (!post.slug?.en?.current) return null;

              return (
                <div
                  class='group flex flex-col animate-in fade-in slide-in-from-bottom-8 fill-mode-both'
                  style={`animation-delay: ${index * 100}ms;`}>
                  {/* Image Wrapper */}
                  <a
                    href={`/en/blog/${post.slug.en.current}`}
                    class='relative aspect-[16/10] overflow-hidden rounded-[1.5rem] mb-6 block border border-slate-100 shadow-sm'>
                    {imageUrl ? (
                      <img
                        src={imageUrl}
                        srcset={imageSrcset}
                        sizes='(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw'
                        alt={title}
                        class='w-full h-full object-cover group-hover:scale-105 transition-transform duration-700'
                        loading='lazy'
                        decoding='async'
                      />
                    ) : (
                      <div class='w-full h-full bg-slate-200 flex items-center justify-center text-slate-400'>
                        No Image
                      </div>
                    )}

                    {/* --- GLASSMORPHISM CATEGORY BADGE --- */}
                    <div class='absolute top-4 left-4 z-10 flex flex-wrap gap-2 max-w-[80%]'>
                      {post.categories?.map((cat: any) => (
                        <div class='px-3 py-1.5 rounded-full bg-white/70 backdrop-blur-md border border-white/40 shadow-[0_4px_12px_rgba(0,0,0,0.05)] text-[9px] font-bold text-slate-900 uppercase tracking-wider'>
                          {cat.title?.[lang]}
                        </div>
                      )) || (
                        <div class='px-3 py-1.5 rounded-full bg-white/70 backdrop-blur-md border border-white/40 shadow-[0_4px_12px_rgba(0,0,0,0.05)] text-[9px] font-bold text-slate-900 uppercase tracking-wider'>
                          General
                        </div>
                      )}
                    </div>
                  </a>

                  {/* Content */}
                  <h3 class='text-xl font-bold text-slate-900 mb-6 line-clamp-2 capitalize flex-grow'>
                    <a
                      href={`/en/blog/${post.slug.en.current}`}
                      class='hover:text-blue-600 transition-colors'>
                      {title}
                    </a>
                  </h3>
                  <p class='text-sm font-light mb-2 text-slate-900'>
                    {new Date(post.publishedAt).toLocaleDateString('en-US', {
                      day: 'numeric',
                      month: 'long',
                      year: 'numeric',
                    })}
                  </p>
                  {/* Read More Link */}
                  <div class='mt-auto flex items-center justify-between'>
                    <a
                      href={`/en/blog/${post.slug.en.current}`}
                      class='inline-flex items-center text-sm font-semibold border border-slate-200 rounded-full px-5 py-2.5 text-slate-600 hover:bg-slate-900 hover:text-white hover:border-slate-900 transition-all duration-300'>
                      Read More
                      <svg
                        class='w-4 h-4 ml-2'
                        xmlns='http://www.w3.org/2000/svg'
                        viewBox='0 0 24 24'
                        fill='none'
                        stroke='currentColor'
                        stroke-width='2'
                        stroke-linecap='round'
                        stroke-linejoin='round'>
                        <path d='M7 17L17 7' />
                        <path d='M7 7h10v10' />
                      </svg>
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        )
      }

      {/* --- PAGINATION UI --- */}
      {
        page.lastPage > 1 && (
          <div class='mt-20 flex items-center justify-center gap-4'>
            {page.url.prev ? (
              <a
                href={page.url.prev}
                class='flex items-center gap-2 px-6 py-3 border border-slate-300 rounded-full font-bold text-sm text-slate-700 hover:bg-slate-900 hover:text-white transition-all shadow-sm'>
                <ChevronLeft className='w-4 h-4' />
                Previous
              </a>
            ) : (
              <button
                disabled
                class='flex items-center gap-2 px-6 py-3 border border-slate-200 rounded-full font-bold text-sm text-slate-400 cursor-not-allowed'>
                <ChevronLeft className='w-4 h-4' />
                Previous
              </button>
            )}

            <span class='text-sm font-semibold text-slate-600 mx-4'>
              Page {page.currentPage} of {page.lastPage}
            </span>

            {page.url.next ? (
              <a
                href={page.url.next}
                class='flex items-center gap-2 px-6 py-3 border border-slate-300 rounded-full font-bold text-sm text-slate-700 hover:bg-slate-900 hover:text-white transition-all shadow-sm'>
                Next
                <ChevronRight className='w-4 h-4' />
              </a>
            ) : (
              <button
                disabled
                class='flex items-center gap-2 px-6 py-3 border border-slate-200 rounded-full font-bold text-sm text-slate-400 cursor-not-allowed'>
                Next
                <ChevronRight className='w-4 h-4' />
              </button>
            )}
          </div>
        )
      }

      {/* Fallback Empty */}
      {
        page.data.length === 0 && (
          <div class='p-20 border-2 border-dashed border-slate-200 rounded-[3rem] text-center text-slate-500 bg-white/50 backdrop-blur-sm'>
            No articles published yet.
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
